{
  "name": "@nihon/backend",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "node --use-system-ca --env-file-if-exists=.env --watch src/server.js",
    "start": "node --use-system-ca --env-file-if-exists=.env src/server.js",
    "db:init": "node scripts/init.js",
    "db:import": "node --max-old-space-size=4096 scripts/import.js",
    "build": "node --max-old-space-size=4096 scripts/import.js && node scripts/check-db.js",
    "db:check": "node scripts/check-db.js",
    "seed:vocab": "node --use-system-ca scripts/seed-vocabulary.js"
  },
  "dependencies": { "tar": "^7.5.7", "kuromoji": "0.1.2" }
}
