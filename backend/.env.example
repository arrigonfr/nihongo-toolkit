PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Separate frontend hosting: set ALLOWED_ORIGINS to its exact HTTPS origin(s).
# Cloudflare same-origin hosting needs no additional allowed origins.
# Defaults to enabled in production, disabled locally. Browsers decode gzip automatically.
API_COMPRESSION=false
# SQLite first; use the Tatoeba API only when local sentences are missing.
SENTENCE_API_FALLBACK=true
# Shiritori only: send exact unknown word lookups to Jisho after a local miss.
# Set false for local-only word validation. Provider failures never count as invalid words.
WORD_API_FALLBACK=true
# Full pasted analysis text is sent to translation providers when enabled.
TRANSLATION_API_FALLBACK=true
