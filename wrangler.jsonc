{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nihongo-toolkit",
  "main": "backend/src/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "PAGE_VIEWS_DB",
      "database_name": "nihongo_toolkit_view",
      "database_id": "7ef173ea-8a39-4697-a279-6f708f2fa545",
      "migrations_dir": "backend/migrations/page-views"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "EXPENSIVE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "alias": {
    "#tokenizer-loader": "./backend/src/tokenizer-worker.js"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./backend/.worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {
    "vars": {
      "CONTACT_ENABLED": "false",
      "TRACK_VISITS": "false",
      "ALLOWED_ORIGINS": "https://develop.nihongotoolkit.pages.dev",
      "SENTENCE_API_FALLBACK": "true",
      "TRANSLATION_API_FALLBACK": "true",
      "WORD_API_FALLBACK": "true",
      "API_COMPRESSION": "true"
    }
  },
  "keep_vars": true,
  "vars": {
    "CONTACT_ENABLED": "true",
    "TRACK_VISITS": "true",
    "ALLOWED_ORIGINS": "https://nihongotoolkit.pages.dev",
    "SENTENCE_API_FALLBACK": "true",
    "TRANSLATION_API_FALLBACK": "true",
    "WORD_API_FALLBACK": "true",
    "API_COMPRESSION": "true"
  }
}