{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nihongo-toolkit",
  "main": "backend/src/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "PAGE_VIEWS_DB",
    "database_name": "nihongo_toolkit_view",
    "database_id": "7ef173ea-8a39-4697-a279-6f708f2fa545",
    "migrations_dir": "backend/migrations/page-views"
  }],
  "alias": {
    "#tokenizer-loader": "./backend/src/tokenizer-worker.js"
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {
      "vars": {
        "TRACK_VISITS": "false",
        "ALLOWED_ORIGINS": "https://develop.nihongo-toolkit.pages.dev",
        "SENTENCE_API_FALLBACK": "true",
        "TRANSLATION_API_FALLBACK": "true",
        "WORD_API_FALLBACK": "true",
        "API_COMPRESSION": "true"
      }
  },
  "vars": {
    "TRACK_VISITS": "false",
    "ALLOWED_ORIGINS": "https://nihongo-toolkit.pages.dev",
    "SENTENCE_API_FALLBACK": "true",
    "TRANSLATION_API_FALLBACK": "true",
    "WORD_API_FALLBACK": "true",
    "API_COMPRESSION": "true"
  }
}
