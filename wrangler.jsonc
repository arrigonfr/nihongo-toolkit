{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nihongo-toolkit",
  "main": "backend/src/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "#tokenizer-loader": "./backend/src/tokenizer-worker.js"
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"],
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "previews": {
      "vars": {
        "SENTENCE_API_FALLBACK": "true",
        "TRANSLATION_API_FALLBACK": "true",
        "WORD_API_FALLBACK": "true",
        "API_COMPRESSION": "true"
      },
      "d1_databases": [
        {
          "binding": "DB_staging",
          "database_name": "nihongo_toolkit_staging",
          "database_id": "c3336c0d-b18e-482b-a3fd-a8b8db38e337",
          "migrations_dir": "backend/migrations"
        },
        {
          "binding": "DB",
          "database_name": "nihongo_toolkit",
          "database_id": "0a65d875-b70b-4c17-a0fb-04b82f47b186",
          "migrations_dir": "backend/migrations"
        }
      ]
  },
  "d1_databases": [
    {
    "binding": "DB_staging",
    "database_name": "nihongo_toolkit_staging",
    "database_id": "c3336c0d-b18e-482b-a3fd-a8b8db38e337",
    "migrations_dir": "backend/migrations"
    },
    {
    "binding": "DB",
    "database_name": "nihongo_toolkit",
    "database_id": "0a65d875-b70b-4c17-a0fb-04b82f47b186",
    "migrations_dir": "backend/migrations"
    }
  ],
  "vars": {
    "SENTENCE_API_FALLBACK": "true",
    "TRANSLATION_API_FALLBACK": "true",
    "WORD_API_FALLBACK": "true",
    "API_COMPRESSION": "true"
  }
}
