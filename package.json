{
  "name": "nihongo-toolkit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "db:init": "npm run db:init -w backend",
    "db:index-words": "node --use-system-ca --env-file-if-exists=backend/.env backend/scripts/index-word-forms.js",
    "db:import": "npm run db:import -w backend",
    "build": "npm run build -w frontend",
    "build:cloudflare": "VITE_API_BASE_URL= npm run build && node backend/scripts/build-tokenizer.js",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "check:cloudflare": "npm run build:cloudflare && wrangler deploy --dry-run",
    "test:cloudflare": "npm run build:cloudflare && node --test backend/test/cloudflare.integration.js",
    "test:page-views": "node --test backend/test/page-views.test.js frontend/test/analysis-stats.test.js backend/test/page-views.integration.js",
    "test:loading": "node scripts/loading-browser-test.mjs",
    "test": "node --test backend/test/*.test.js frontend/test/*.test.js",
    "test:conjugator": "node --test backend/test/conjugator.test.js frontend/test/conjugation.test.js && node scripts/conjugator-browser-test.mjs",
    "test:conjugation-practice": "node --test frontend/test/conjugation-practice.test.js frontend/test/conjugation.test.js && node scripts/conjugation-practice-browser-test.mjs",
    "test:e2e": "node scripts/browser-test.mjs && node scripts/shared-ui-browser-test.mjs",
    "test:tool-fixes": "VITE_SITE_URL=https://nihongo-toolkit.pages.dev npm run build && node scripts/tool-fixes-browser-test.mjs",
    "test:settings": "node scripts/settings-browser-test.mjs && node scripts/settings-availability-browser-test.mjs",
    "test:study-improvements": "node scripts/study-improvements-browser-test.mjs",
    "test:session-flow": "node scripts/session-flow-browser-test.mjs",
    "test:reading-options": "node --test frontend/test/reading-answers.test.js backend/test/practice-kanji.test.js && node scripts/reading-options-browser-test.mjs",
    "test:answer-feedback": "node scripts/answer-feedback-browser-test.mjs",
    "test:goi-vocabulary": "node --test backend/test/vocabulary-answers.test.js frontend/test/vocabulary-answers.test.js && node scripts/goi-vocabulary-browser-test.mjs",
    "test:selects": "node scripts/select-browser-test.mjs",
    "test:shiritori": "node --test backend/test/shiritori.test.js && node scripts/shiritori-browser-test.mjs",
    "test:word-search": "node --test frontend/test/word-search.test.js backend/test/database.test.js && node scripts/word-search-browser-test.mjs",
    "test:memory": "node --test frontend/test/memory.test.js && node scripts/memory-browser-test.mjs",
    "test:crossword": "node --test frontend/test/crossword.test.js && node scripts/crossword-browser-test.mjs",
    "test:game-exports": "node scripts/game-export-browser-test.mjs",
    "seed:vocab": "npm run seed:vocab -w backend --",
    "db:enrich": "node --use-system-ca backend/scripts/enrich.js",
    "db:enrich-jlpt": "node --max-old-space-size=4096 --use-system-ca backend/scripts/enrich-jlpt.js",
    "db:sync-jlpt": "node --use-system-ca --env-file-if-exists=backend/.env backend/scripts/sync-jlpt.js",
    "test:jlpt-enrichment": "node --test backend/test/jlpt-enrichment.test.js",
    "db:discover-words": "node --use-system-ca backend/scripts/discover-words.js",
    "db:generate-examples": "node backend/scripts/generate-examples.js",
    "db:review-examples": "node backend/scripts/review-examples.js",
    "db:sync-turso": "node --use-system-ca --env-file-if-exists=backend/.env backend/scripts/sync-enrichment.js",
    "test:examples": "node --test backend/test/examples.test.js backend/test/enrichment.test.js && node scripts/example-provenance-browser-test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "miniflare": "^4.0.0",
    "playwright": "^1.58.2",
    "wrangler": "^4.0.0"
  }
}
