VITE_API_BASE_URL=http://localhost:3000
# Optional D1 page views: also enable TRACK_VISITS in the Worker; see README.
TRACK_VISITS=false
# Optional contact form: public Turnstile site key (never its secret key).
# VITE_TURNSTILE_SITE_KEY=your-public-site-key
# The language picker stays hidden (English only) until study content is fully translated.
# VITE_LANGUAGE_SELECTION=true
# Cloudflare builds override the API URL to empty (same origin).
# Optional public canonical origin, once you know your deployed URL:
# VITE_SITE_URL=https://nihongotoolkit.pages.dev
# Optional Google Analytics 4 / Tag Manager (set in production builds only; Consent Mode v2 enabled):
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_GTM_ID=GTM-XXXXXXXX
